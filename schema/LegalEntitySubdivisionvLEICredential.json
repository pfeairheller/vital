{
  "$id": "EOvrvccCry9lWXMqdlnysBJ3JYUQg6wihIsLM1_dc-4U",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Legal Entity Subdivision vLEI Credential",
  "description": "A vLEI Credential issued by a Qualified vLEI issuer to a Legal Entity Subdivision",
  "type": "object",
  "credentialType": "LegalEntitySubdivisionvLEICredential",
  "version": "1.0.0",
  "properties": {
    "v": {
      "description": "Version",
      "type": "string"
    },
    "d": {
      "description": "Credential SAID",
      "type": "string"
    },
    "u": {
      "description": "One time use nonce",
      "type": "string"
    },
    "i": {
      "description": "QVI Issuer AID",
      "type": "string"
    },
    "ri": {
      "description": "Credential status registry",
      "type": "string"
    },
    "s": {
      "description": "Schema SAID",
      "type": "string"
    },
    "a": {
      "oneOf": [
        {
          "description": "Attributes block SAID",
          "type": "string"
        },
        {
          "$id": "EPj-qB_N1ZIdUarDtsoQie-U6E28U-ph1lteroMk8Em5",
          "description": "Attributes block",
          "type": "object",
          "properties": {
            "d": {
              "description": "Attributes block SAID",
              "type": "string"
            },
            "i": {
              "description": "LE Issuer AID",
              "type": "string"
            },
            "dt": {
              "description": "issuance date time",
              "type": "string",
              "format": "date-time"
            },
            "LEI": {
              "description": "LE Issuer AID",
              "type": "string",
              "format": "ISO 17442"
            },
            "subdivisionLegalName": {
              "description": "Subdivision name",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "i",
            "dt",
            "LEI"
          ]
        }
      ]
    },
    "e": {
      "oneOf": [
        {
          "description": "Edges block SAID",
          "type": "string"
        },
        {
          "$id": "EM-__Jcv3Cr1J0nF5QgW8-vWP05DHAJUTcieXvMsqtrA",
          "description": "Edges block",
          "type": "object",
          "properties": {
            "d": {
              "description": "Edges block SAID",
              "type": "string"
            },
            "subdivision": {
              "description": "Ownership chain to legal entity subdivision vLEI Credential",
              "type": "object",
              "properties": {
                "n": {
                  "description": "SAID of the ACDC to which the edge connects",
                  "type": "string"
                },
                "s": {
                  "description": "SAID of required schema of the credential pointed to by this node",
                  "type": "string"
                },
                "o": {
                  "description": "Operator indicating this node is the issuer",
                  "type": "string",
                  "const": "NI2I"
                }
              },
              "additionalProperties": false,
              "required": [
                "n",
                "s",
                "o"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "d",
            "subdivision"
          ]
        },
        {
          "$id": "EM2Na3M-wBI1PIo3-T6uE4xQ3Iq7unXppNPNxa1OTQVp",
          "description": "Edges block for ownership by Legal Entity",
          "type": "object",
          "properties": {
            "d": {
              "description": "SAID of edges block",
              "type": "string"
            },
            "le": {
              "description": "Ownership chain to legal entity vLEI credential",
              "type": "object",
              "properties": {
                "n": {
                  "description": "SAID of the ACDC to which the edge connects",
                  "type": "string"
                },
                "s": {
                  "description": "SAID of required schema of the credential pointed to by this node",
                  "type": "string",
                  "const": "ENPXp1vQzRF6JwIuS-mp2U8Uf1MoADoP_GqQ62VsDZWY"
                },
                "o": {
                  "description": "Chaining operator",
                  "type": "string",
                  "const": "NI2I"
                }
              },
              "additionalProperties": false,
              "required": [
                "n",
                "s",
                "o"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "d",
            "le"
          ]
        }
      ]
    },
    "r": {
      "oneOf": [
        {
          "description": "Rules block SAID",
          "type": "string"
        },
        {
          "$id": "ECllqarpkZrSIWCb97XlMpEZZH3q4kc--FQ9mbkFMb_5",
          "description": "Rules block",
          "type": "object",
          "properties": {
            "d": {
              "description": "Rules block SAID",
              "type": "string"
            },
            "usageDisclaimer": {
              "description": "Usage Disclaimer",
              "type": "object",
              "properties": {
                "l": {
                  "description": "Associated legal language",
                  "type": "string",
